<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd equivalent of aicam-review.service.

  This has to run on the same host as aicam: the "Flag for Review" link in a
  Pushover alert resolves to a file under save-path/review/, and the server
  reads it off local disk. Home Assistant's rest_command.aicam_roboflow_upload
  must point here.

  Install to ~/Library/LaunchAgents/com.brianegge.aicam-review.plist and load with
      launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.brianegge.aicam-review.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.brianegge.aicam-review</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/claw/aicam/.venv/bin/python</string>
        <string>-u</string>
        <string>/Users/claw/aicam/roboflow_upload.py</string>
        <string>--port</string>
        <string>5050</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/claw/aicam</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/claw/aicam-data/aicam-review.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/claw/aicam-data/aicam-review.log</string>
</dict>
</plist>
